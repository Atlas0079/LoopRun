{
  "name": "looprun",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "圈界 Android 跑步领地 App 与服务器",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "check": "node scripts/check.mjs",
    "test:local": "node --test .local-tests/*.test.mjs",
    "gps:dev": "tsx --env-file-if-exists=.env.gps.local server/gps.ts",
    "gps:check": "tsc --noEmit -p server/tsconfig.json",
    "android:build": "node scripts/build-android.mjs",
    "gps:db": "node scripts/gps-local.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
