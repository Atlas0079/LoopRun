.run-stats{display:flex;gap:60rpx;margin:15rpx 0 25rpx}.run-stats>view{display:flex;flex-direction:column;gap:15rpx;color:#9bab88;font-size:22rpx}.run-stats text{color:#35472b;font-size:67rpx;font-weight:500;font-variant-numeric:tabular-nums}.share-row{display:flex;align-items:center;gap:20rpx;justify-content:space-between;margin:35rpx 0}.share-row .subtitle{font-size:20rpx;margin-top:10rpx}.run-actions{display:flex;gap:20rpx;margin-top:30rpx}.run-actions>.primary{flex:2}.run-actions>.secondary{flex:1}.big-number{font-size:90rpx;margin:35rpx 0 20rpx}.big-number text{font-size:30rpx;color:#a2b18c}.report-grid{display:flex;justify-content:space-between;margin:40rpx 0}.report-grid>view{display:flex;flex-direction:column;gap:15rpx;color:#a0b088;font-size:22rpx}.report-grid text{font-size:45rpx;color:#6e8b49}
