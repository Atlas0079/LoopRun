<view class="page"><view class="title">跑步记录</view><view class="subtitle">原始轨迹仅自己可查看。</view><view class="error" wx:if="{{error}}">{{error}}</view><view class="card" wx:if="{{!activities.length}}">暂无跑步记录，完成有效闭环后在此查看。</view><view class="history-row card" wx:for="{{activities}}" wx:key="id" bindtap="select" data-id="{{item.id}}"><view class="row"><view><view class="section-title">{{item.displayDate}}</view><view class="subtitle">{{item.source === 'simulation' ? '道路规划回放' : 'GPS 跑步'}}</view></view><view class="history-distance">{{item.displayDistance}}<text> km</text></view></view><view class="history-changes">新占 {{item.claimed}} 格 / 加固 {{item.fortified}} 格 / 削弱 {{item.weakened}} 格</view></view></view>
<view class="privacy" wx:if="{{selected}}"><view class="privacy-inner history-detail"><view class="title">{{selected.displayDate}} 的闭环</view><map latitude="{{center.latitude}}" longitude="{{center.longitude}}" scale="16" polyline="{{polyline}}" style="width:100%;height:500rpx"></map><view class="notice">{{selected.displayDistance}} km · 新占 {{selected.claimed}} 格 / 削弱 {{selected.weakened}} 格</view><button class="primary" bindtap="close">回到记录</button></view></view>
