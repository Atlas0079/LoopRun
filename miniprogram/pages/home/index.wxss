.territory{margin-top:28rpx}.area{font-size:88rpx;font-weight:500;letter-spacing:-3rpx;margin:30rpx 0}.area text{font-size:26rpx;color:#a5b08f;letter-spacing:0}.map-card{border-radius:21rpx;overflow:hidden;background:#fff;border:1rpx solid #e1e8d4;margin:25rpx 0}.map-title{padding:28rpx}.legend{display:flex;gap:35rpx;padding:26rpx;font-size:20rpx;color:#91a277}.legend-dot{height:14rpx;width:14rpx;display:inline-block;border-radius:3rpx;margin-right:9rpx}.mine{background:#d8f16b}.rival{background:#a6b8ff}.neutral{background:#adb7a2}.run-cta{background:#233124;padding:33rpx;border-radius:23rpx;margin:26rpx 0;color:#eff5e4}.run-cta .subtitle{margin:20rpx 0 28rpx;color:#94a87f}.member{display:flex;align-items:center;gap:20rpx;padding:25rpx 0;border-bottom:1rpx solid #edf1e5;font-size:24rpx}.member .avatar{font-size:18rpx}.member>.muted{margin-left:auto}.card>.secondary{margin-top:25rpx}.actions{display:flex;gap:20rpx}.actions button{flex:1}.welcome{margin-top:30rpx}.welcome .subtitle{margin:20rpx 0 30rpx}.welcome button{margin-top:18rpx}
.page{padding-bottom:210rpx}.run-cta{position:fixed;left:0;right:0;bottom:0;z-index:20;margin:0;border-radius:0;background:#fff;color:#263e32;padding:18rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dfe6e2}.run-cta .subtitle{margin:0 0 14rpx;color:#687870;font-size:22rpx}.legend{gap:22rpx;font-size:20rpx}
