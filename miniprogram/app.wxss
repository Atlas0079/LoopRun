page{background:#f4f6ee;color:#273426;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:26rpx}view,text,button,input{box-sizing:border-box}button{font-size:25rpx;font-weight:500;border-radius:15rpx;line-height:1.5;padding:22rpx 26rpx;background:#edf3df;color:#546a3e}button::after{border:0}.primary{background:#1e5545;color:#fff;font-weight:600}.secondary{background:#f3f7e9;border:1rpx solid #dce6cc;color:#345b48}.muted{color:#687870}.eyebrow{color:#9aa88b;font-size:17rpx;letter-spacing:3rpx}.title{font-size:42rpx;font-weight:600;line-height:1.6;margin:14rpx 0}.subtitle{font-size:23rpx;color:#687870;line-height:1.9}.card{background:#fff;border:1rpx solid #e3e9d8;border-radius:22rpx;padding:30rpx;margin-bottom:25rpx}.badge{color:#96a978;font-size:19rpx;background:#edf4df;padding:8rpx 14rpx;border-radius:9rpx}.notice{background:#edf3df;color:#6b633f;padding:22rpx;border-radius:13rpx;font-size:22rpx;line-height:1.9;margin:20rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.small{font-size:20rpx}.section-title{font-size:26rpx;font-weight:600}.page{padding:32rpx 30rpx 70rpx}.footer{text-align:center;color:#a4af96;font-size:18rpx;margin:40rpx 0}.avatar{height:58rpx;width:58rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#33442b;font-weight:600;font-size:24rpx;flex-shrink:0}.error{color:#ae815d;background:#fbf1e7;padding:22rpx;border-radius:14rpx;font-size:23rpx;line-height:1.8;margin-bottom:20rpx}.privacy{position:fixed;inset:0;background:#112216b8;z-index:100;display:flex;align-items:center;justify-content:center;padding:50rpx}.privacy-inner{background:#fbfdf5;padding:40rpx;border-radius:24rpx}.privacy-inner .title{font-size:33rpx}.privacy-inner .subtitle{margin:25rpx 0}.privacy-inner button{margin-top:20rpx}
